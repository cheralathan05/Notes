# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workspace_saas?schema=public"

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET="dev-secret-not-for-production-use-only-local"
SESSION_MAX_AGE=604800000

# ─── URLs ─────────────────────────────────────────────────────────────────────
APP_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM="noreply@workspace.app"
