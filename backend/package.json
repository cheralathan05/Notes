{
  "name": "workspace-saas-backend",
  "version": "1.0.0",
  "description": "Backend API for Productivity + AI Workspace SaaS",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"try{require('fs').writeFileSync('dist/index.js', \\\"require('./backend/src/index.js');\\\")}catch(e){}\"",
    "start": "node dist/backend/src/index.js",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch --config jest.config.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:email": "tsx scripts/test-email.ts",
    "prisma:generate": "node scripts/prisma-generate.js",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev --schema=../prisma/schema.prisma",
    "prisma:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy --schema=../prisma/schema.prisma",
    "prisma:db:push": "node scripts/db-push-retry.js",
    "prisma:studio": "node node_modules/prisma/build/index.js studio --schema=../prisma/schema.prisma",
    "render:build": "npm run prisma:generate && npm run build",
    "render:start": "npm run prisma:db:push && npm start"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.16",
    "prisma": "^6.19.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.17",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
