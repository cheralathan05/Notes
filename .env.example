# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workspace_saas?schema=public"

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET="change-me-to-a-64-char-random-string-in-production"
SESSION_MAX_AGE=604800000

# ─── URLs ─────────────────────────────────────────────────────────────────────
APP_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Email & SMTP Configuration ───────────────────────────────────────────────
# EMAIL_PROVIDER=console (default for local dev) or 'smtp' / 'gmail'
EMAIL_PROVIDER=console
EMAIL_FROM="KRONOS Workspace <noreply@workspace.app>"
EMAIL_FROM_NAME="KRONOS Workspace"

# SMTP (required when EMAIL_PROVIDER=smtp or EMAIL_PROVIDER=gmail)
# For Gmail:
# SMTP_SERVICE=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_google_app_password
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

